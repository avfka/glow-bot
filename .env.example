# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Секреты Edge Functions (задаются через `supabase secrets set`, не через Vite) ---
# TELEGRAM_BOT_TOKEN=токен бота от BotFather (для валидации initData и напоминаний)
# ANTHROPIC_API_KEY=ключ Anthropic для AI-разбора составов
# AUTH_PEPPER=случайная строка 32+ символов (детерминированные пароли auth-пользователей)
